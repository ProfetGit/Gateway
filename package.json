{
  "name": "gateway",
  "productName": "Gateway",
  "version": "1.0.0",
  "author": "ProfetGit",
  "description": "A Linux game launcher for your Steam, Heroic, and Lutris libraries.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation vite",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build && electron-builder --linux AppImage --publish never",
    "release": "tsc && tsc -p tsconfig.electron.json && vite build && electron-builder --linux AppImage --publish always",
    "preview": "vite preview",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "check:secrets": "! grep -rEn \"(sk-|api[_-]?key\\\\s*[:=]\\\\s*[\\\"'][a-zA-Z0-9]{20,})\" src electron --include=\"*.ts\" --include=\"*.tsx\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtuoso": "^4.17.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.profetgit.gateway",
    "productName": "Gateway",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "emppu.saranpaa@gmail.com",
      "desktop": {
        "StartupWMClass": "Gateway"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ProfetGit",
        "repo": "Gateway"
      }
    ]
  }
}
